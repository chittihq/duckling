# ===========================================
# Duckling Environment Configuration
# ===========================================

# Storage
# Each service defaults to a Docker named volume on the host's boot disk. Set
# any of these to an ABSOLUTE host path to store that data elsewhere (e.g. an
# attached block volume). Unset = named volume, exactly as before. No compose
# edits needed. See docs/DEPLOYMENT.md.
# DUCKLING_CLICKHOUSE_DATA=/mnt/your_volume/duckling/clickhouse   # the big one
# DUCKLING_APP_DATA=/mnt/your_volume/duckling/app
# DUCKLING_RUSTFS_DATA=/mnt/your_volume/duckling/rustfs           # needs chown 10001:10001
# DUCKLING_CATALOG_DATA=/mnt/your_volume/duckling/catalog

# Server Configuration
NODE_ENV=development
PORT=3000

# MySQL wire protocol server (BI tools / mysql clients query the replica)
# MYSQL_PROTOCOL_ENABLED=true
# MYSQL_PROTOCOL_PORT=3307
# Serve MySQL on the HTTP port instead of a dedicated one (single published
# port). Detection: HTTP clients send first; MySQL clients wait silently for
# the server greeting. MySQL is raw TCP either way — reach it via IP:port
# directly, not through an HTTP reverse-proxy domain.
# MYSQL_PROTOCOL_SHARED_PORT=false
# MYSQL_PROTOCOL_DETECTION_TIMEOUT_MS=50

# Database Configuration
MYSQL_MAX_CONNECTIONS=5
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
# Apply `final=1` to all reads so ReplacingMergeTree tables (peerdb mode)
# return deduplicated state. No-op in polling mode. Requires ClickHouse >= 23.2.
CLICKHOUSE_FINAL_READS=true

# Replication backend
REPLICATION_BACKEND=duckling
# Note: CDC-lite (binlog tailer augmenting polling mode) has no flag — it is
# capability-driven per database: full CDC capability → peerdb; ROW binlogs +
# replication grants → polling + CDC-lite; otherwise pure polling.

# PeerDB (used when REPLICATION_BACKEND=peerdb)
PEERDB_ENABLED=false
PEERDB_API_URL=http://localhost:8113
PEERDB_UI_URL=http://localhost:3003
PEERDB_API_KEY=
PEERDB_SQL_HOST=localhost
PEERDB_SQL_PORT=9900
PEERDB_SQL_USER=peerdb
PEERDB_SQL_PASSWORD=peerdb
PEERDB_SQL_DATABASE=peerdb
PEERDB_SOURCE_PEER_PREFIX=mysql
PEERDB_TARGET_PEER_PREFIX=clickhouse
PEERDB_MIRROR_PREFIX=duckling
PEERDB_CLICKHOUSE_HOST=clickhouse
PEERDB_CLICKHOUSE_PORT=9000
PEERDB_CLICKHOUSE_TLS=false
PEERDB_FLOW_JOB_PREFIX=duckling
PEERDB_MYSQL_DISABLE_TLS=true
PEERDB_MYSQL_FLAVOR=mysql
PEERDB_MYSQL_REPLICATION_MECHANISM=auto
PEERDB_MYSQL_SETUP=set names utf8mb4

# RustFS / S3-compatible staging for PeerDB
RUSTFS_ENDPOINT=http://localhost:9002
RUSTFS_ACCESS_KEY=peerdb
RUSTFS_SECRET_KEY=peerdbsecret
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=peerdb-stage
RUSTFS_USE_PATH_STYLE=true
AWS_ENDPOINT_URL_S3=http://localhost:9002
AWS_ACCESS_KEY_ID=peerdb
AWS_SECRET_ACCESS_KEY=peerdbsecret
AWS_REGION=us-east-1
PEERDB_S3_BUCKET=peerdb-stage

# PeerDB self-hosted infrastructure
PEERDB_CATALOG_POSTGRES_DB=peerdb
PEERDB_CATALOG_POSTGRES_USER=peerdb
PEERDB_CATALOG_POSTGRES_PASSWORD=peerdb
PEERDB_TEMPORAL_POSTGRES_DB=temporal
PEERDB_TEMPORAL_POSTGRES_USER=temporal
PEERDB_TEMPORAL_POSTGRES_PASSWORD=temporal

# Sync Configuration
SYNC_INTERVAL_MINUTES=15
BATCH_SIZE=1000
MAX_RETRIES=3
ENABLE_INCREMENTAL_SYNC=true

# Health Checks
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_INTERVAL=60000

# Logging
LOG_LEVEL=info

# Security & Authentication (REQUIRED)
# WARNING: These MUST be set to secure values before deploying to production!
# Generate secure values using: openssl rand -hex 32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme-use-strong-password
DB_API_KEY=your-secure-api-key-here
SESSION_SECRET=generate-with-openssl-rand-hex-32

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MODE=enforce
RATE_LIMIT_USE_SESSION_SCOPE=false
RATE_LIMIT_INCLUDE_DB_SCOPE=true
RATE_LIMIT_READ_MAX=120
RATE_LIMIT_QUERY_MAX=80
RATE_LIMIT_COST_QUERY=1
RATE_LIMIT_COST_WRITE=3
RATE_LIMIT_JWT_QUERY_MAX_IN_FLIGHT=6
RATE_LIMIT_APIKEY_QUERY_MAX_IN_FLIGHT=12
RATE_LIMIT_QUERY_INFLIGHT_TTL_MS=300000
# Concurrent long-lived SSE streams per identity (/sync/events). Request-rate
# limits can't bound these — each stream holds a socket + timer until closed.
# RATE_LIMIT_JWT_STREAM_MAX=8
# RATE_LIMIT_APIKEY_STREAM_MAX=16
# RATE_LIMIT_ANON_STREAM_MAX=2
