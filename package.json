{
  "name": "duckling-monorepo",
  "version": "0.5.2",
  "description": "Duckling - ClickHouse server with MySQL replication (monorepo)",
  "private": true,
  "scripts": {
    "build": "pnpm --filter \"./packages/**\" build",
    "build:shared": "pnpm --filter @chittihq/duckling-shared build",
    "build:sdk": "pnpm --filter @chittihq/duckling build",
    "build:server": "pnpm --filter @chittihq/duckling-server build",
    "build:frontend": "pnpm --filter @chittihq/duckling-frontend build",
    "dev": "pnpm --parallel --filter \"./packages/**\" dev",
    "dev:server": "pnpm --filter @chittihq/duckling-server dev",
    "dev:frontend": "pnpm --filter @chittihq/duckling-frontend dev",
    "dev:sdk": "pnpm --filter @chittihq/duckling dev",
    "start:server": "pnpm --filter @chittihq/duckling-server start",
    "start:frontend": "pnpm --filter @chittihq/duckling-frontend preview",
    "sync": "pnpm --filter @chittihq/duckling-server sync",
    "sync:incremental": "pnpm --filter @chittihq/duckling-server sync:incremental",
    "health": "pnpm --filter @chittihq/duckling-server health",
    "status": "pnpm --filter @chittihq/duckling-server status",
    "validate": "pnpm --filter @chittihq/duckling-server validate",
    "clean": "pnpm --parallel --filter \"./packages/**\" exec rm -rf dist .nuxt .output node_modules",
    "typecheck": "pnpm --filter \"./packages/**\" exec tsc --noEmit",
    "test:integration": "pnpm --filter integration-tests test"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [],
    "overrides": {
      "rollup": "4.59.1",
      "jws": "^3.2.3",
      "path-to-regexp@0.1.12": "0.1.13",
      "qs": "^6.15.2",
      "body-parser": "^1.20.6",
      "fast-xml-parser": "^5.7.0",
      "@opentelemetry/core": "^2.8.0",
      "defu": "^6.1.5",
      "svgo": "^4.0.2",
      "brace-expansion@1": "^1.1.16",
      "brace-expansion@2": "^2.1.2",
      "brace-expansion@5": "^5.0.8",
      "minimatch@3": "^3.1.4",
      "minimatch@9": "^9.0.7",
      "glob@10": "^10.5.0"
    }
  }
}
